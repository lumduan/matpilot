{
  "name": "matpilot",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-only block-based programming and control for LEGO SPIKE Prime hubs running Pybricks firmware.",
  "license": "MIT",
  "author": "Sarat Sonsuk",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "dev": "node scripts/vendor-assets.mjs && next dev",
    "build": "node scripts/vendor-assets.mjs && next build && node scripts/verify-export.mjs",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/common": "1.5.5",
    "@lezer/python": "1.1.19",
    "@micropython/micropython-webassembly-pyscript": "1.29.0-6",
    "@pybricks/mpy-cross-v6": "2.0.0",
    "blockly": "13.4.0",
    "next": "16.4.5",
    "openai": "7.53.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-bluetooth": "0.0.22",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
