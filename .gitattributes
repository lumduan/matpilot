# Normalise all text files to LF in the repository and in working trees.
* text=auto eol=lf

# Binary assets: never touch line endings, never diff as text.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.wasm   binary
*.mpy    binary

